import logging
from enum import Enum

_warned: set[str] = set()


class {{ enum.class_info.name }}(str, Enum):
    {% for key, value in enum.values|dictsort(true) %}
    {{ key }} = "{{ value }}"
    {% endfor %}

    def __str__(self) -> str:
        return str(self.value)

    @classmethod
    def _missing_(cls, value: object) -> "{{ enum.class_info.name }} | None":
        # A value the API has started sending since this client's schema was
        # pinned (a new file variant, say). Keep it as an unnamed member instead
        # of failing the whole response: callers that care check for the
        # members they know. Templated in client-templates/, see generate-client.sh.
        if not isinstance(value, str):
            return None
        if value not in _warned:
            _warned.add(value)
            logging.getLogger(__name__).warning(
                "%s got %r, which the pinned schema doesn't list; keeping it", cls.__name__, value
            )
        member = str.__new__(cls, value)
        member._name_ = value
        member._value_ = value
        return member

from enum import IntEnum
import logging

# Values already reported, so a schedule reload doesn't log them again.
_reported: set[object] = set()

class {{ enum.class_info.name }}(IntEnum):
    {% for key, value in enum.values.items() %}
    {{ key }} = {{ value }}
    {% endfor %}

    def __str__(self) -> str:
        return str(self.value)

    @classmethod
    def _missing_(cls, value: object) -> "{{ enum.class_info.name }} | None":
        # A value the API added after playout's schema was pinned. Read it as
        # an extra member instead of failing the whole object; see
        # client-templates/README.md.
        if not isinstance(value, int) or isinstance(value, bool):
            return None
        member = int.__new__(cls, value)
        member._name_ = "UNKNOWN"
        member._value_ = value
        if value not in _reported:
            _reported.add(value)
            logging.getLogger(__name__).warning(
                "%s got %r, which playout's pinned schema doesn't list; keeping it",
                cls.__name__,
                value,
            )
        return member
